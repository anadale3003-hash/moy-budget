{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autumn-resonance-d140",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "30 5 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBSCRIPTIONS",
        "class_name": "SubscriptionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SubscriptionStore"
      ]
    }
  ]
}
